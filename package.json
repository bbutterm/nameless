{
  "name": "nameless",
  "private": true,
  "version": "0.1.0",
  "description": "Безымянный — нарративный рогалик-RPG (PWA, портрет)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @nameless/client build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @nameless/client dev",
    "sim": "pnpm --filter @nameless/sim sim",
    "validate": "pnpm --filter @nameless/content validate",
    "ci": "pnpm typecheck && pnpm validate && pnpm test && pnpm sim && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
