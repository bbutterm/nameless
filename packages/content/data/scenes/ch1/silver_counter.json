      "next": "issue_lot"
    },
    {
      "kind": "branch",
      "id": "r_signature",
      "branches": [
        { "when": { "kind": "deaths", "op": "gte", "value": 1 }, "to": "r_signature_again" }
      ],
      "fallback": "r_signature_first"
    },
    {
      "kind": "say",
      "id": "r_signature_first",
      "speaker": "osoka",
      "text": {
        "ru": "Не положено. Ваша строка длиннее прочих.",
        "en": "Not permitted. Your line is longer than the rest."
      },
      "next": "issue_lot"
    },
    {
      "kind": "say",
      "id": "r_signature_again",
      "speaker": "osoka",
      "text": {
        "ru": "Не положено. Спрашивайте у Учёта.",
        "en": "Not permitted. Ask the Reckoning."
      },
      "next": "issue_lot"
    },
    {
      "kind": "branch",
      "id": "r_silent",
      "branches": [
        { "when": { "kind": "deaths", "op": "gte", "value": 1 }, "to": "r_silent_again" }
      ],
      "fallback": "r_silent_first"
    },
    {
      "kind": "say",
      "id": "r_silent_first",
      "speaker": "osoka",
      "text": {
        "ru": "Принято. Молчите вы правильно: я реже сбиваюсь.",
        "en": "Noted. You keep silence correctly: I lose my place less often."
      },
      "next": "issue_lot"
    },
    {
      "kind": "say",
      "id": "r_silent_again",
      "speaker": "osoka",
      "text": { "ru": "Принято. Продолжаем по порядку.", "en": "Noted. We continue in order." },
      "next": "issue_lot"
    },
    {
      "kind": "branch",
      "id": "r_count",
      "branches": [{ "when": { "kind": "deaths", "op": "gte", "value": 1 }, "to": "r_count_again" }],
      "fallback": "r_count_first"
    },
    {
      "kind": "say",
      "id": "r_count_first",
      "speaker": "osoka",
      "text": {
        "ru": "Двести одиннадцать. Считаете и вы — редкость.",
        "en": "Two hundred eleven. You count too — that is rare."
      },
      "next": "issue_lot"
    },
    {
      "kind": "say",
      "id": "r_count_again",
      "speaker": "osoka",
      "text": {
        "ru": "Двести восемьдесят четыре. Следующий — вы.",
        "en": "Two hundred eighty-four. You are next."
      },
      "next": "issue_lot"
    },
    {
      "kind": "branch",
      "id": "r_mercy",
      "branches": [{ "when": { "kind": "deaths", "op": "gte", "value": 1 }, "to": "r_mercy_again" }],
      "fallback": "r_mercy_first"
    },
    {
      "kind": "say",
      "id": "r_mercy_first",
      "speaker": "osoka",
      "text": {
        "ru": "У вас хвост из должников до самой Слузы. Приняла.",
        "en": "You have a tail of debtors trailing to the Sluza. Noted."
      },
      "next": "issue_lot"
    },
    {
      "kind": "say",
      "id": "r_mercy_again",
      "speaker": "osoka",
      "text": {
        "ru": "Очередь по поступлению. Не положено.",
        "en": "The queue goes by arrival. Not permitted."
      },
      "next": "issue_lot"
    },
    {
      "kind": "narration",
      "id": "issue_lot",
      "text": {
        "ru": "Она переворачивает страницу и находит нужный бланк с третьей попытки: бланки на неустойку лежат отдельно, потому что нужны один раз в четыреста лет.",
        "en": "She turns the page and finds the right form on the third try: the penalty forms are kept apart, because they are needed once in four hundred years."
      },
      "next": "osoka_penalty"
    },
    {
      "kind": "say",
      "id": "osoka_penalty",
      "speaker": "osoka",
      "text": {
        "ru": "Неустойка за беспокойство: один лот. Из вашего архива, по резонансу.",
        "en": "Penalty for inconvenience: one lot. From your own archive, by resonance."
      },
