      "id": "cause_guard",
      "speaker": "osoka",
      "text": {
        "ru": "Причина: древко, под ребро, слева. Оформлено.",
        "en": "Cause: shaft, under the rib, left side. Recorded."
      },
      "next": "death_guard_pike"
    },
    {
      "kind": "say",
      "id": "cause_shelf",
      "speaker": "osoka",
      "text": {
        "ru": "Причина: стеллаж, ярус третий. Убыток посчитают отдельно.",
        "en": "Cause: shelving, tier three. Damages will be counted separately."
      },
      "next": "death_shelf"
    },
    {
      "kind": "say",
      "id": "cause_scavengers",
      "speaker": "osoka",
      "text": {
        "ru": "Причина: карманы, пристань. Содержимое к возврату не заявлено.",
        "en": "Cause: pockets, the pier. Contents not claimed for return."
      },
      "next": "death_scavengers"
    },
    {
      "kind": "say",
      "id": "cause_guild",
      "speaker": "osoka",
      "text": {
        "ru": "Причина: взыскание на месте. Взыскатель в описи не назван.",
        "en": "Cause: collection on the spot. The collector is not named in the record."
      },
      "next": "death_guild_debt"
    },
    {
      "kind": "say",
      "id": "cause_sluza",
      "speaker": "osoka",
      "text": {
        "ru": "Причина: река. Воду в счёт не берём.",
        "en": "Cause: the river. Water is not entered as payment."
      },
      "next": "death_sluza"
    },
    {
      "kind": "say",
      "id": "cause_vytsvet",
      "speaker": "osoka",
      "text": {
        "ru": "Причина: край Выцвети, ночь. Одна строка утрачена.",
        "en": "Cause: the edge of the Vytsvet, night. One line lost."
      },
      "next": "death_vytsvet_night"
    },
    { "kind": "death", "id": "death_guard_pike", "death": "death_guard_pike" },
    { "kind": "death", "id": "death_shelf", "death": "death_shelf" },
    { "kind": "death", "id": "death_scavengers", "death": "death_scavengers" },
