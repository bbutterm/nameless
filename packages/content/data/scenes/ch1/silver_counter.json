      "fallback": "r_beyond_first"
    },
    {
      "kind": "say",
      "id": "r_beyond_first",
      "speaker": "osoka",
      "text": {
        "ru": "Не положено, и я не знаю. Я тоже туда не смотрела ни разу.",
        "en": "Not permitted, and I do not know. I have never looked in there either."
      },
      "next": "issue_lot"
    },
    {
      "kind": "say",
      "id": "r_beyond_again",
      "speaker": "osoka",
      "text": {
        "ru": "Не положено. По описи такого нет.",
        "en": "Not permitted. No such line in the inventory."
