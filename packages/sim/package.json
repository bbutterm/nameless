{
  "name": "@nameless/sim",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sim": "pnpm --filter @nameless/content gen && tsx src/cli.ts",
    "sim:baseline": "pnpm --filter @nameless/content gen && tsx src/cli.ts --update-baseline",
    "sim:battles": "tsx src/cli.ts --only=battles",
    "sim:dialogue": "tsx src/cli.ts --only=dialogue",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nameless/content": "workspace:*",
    "@nameless/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
