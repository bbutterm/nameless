{
  "name": "@nameless/client",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @nameless/content gen",
    "dev": "vite --host",
    "prebuild": "pnpm --filter @nameless/content gen",
    "build": "vite build && node scripts/stamp-sw.mjs dist && node scripts/mirror-dist.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nameless/content": "workspace:*",
    "@nameless/engine": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
